# Copy this file to .env and fill in your Alpaca keys.
# Paper trading keys: https://app.alpaca.markets (Paper account -> API Keys)
ALPACA_API_KEY=your_key_here
ALPACA_API_SECRET=your_secret_here

# Paper trading by default. For live trading (real money, own risk):
# ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market data feed: "iex" is free, "sip" requires a paid data subscription.
ALPACA_DATA_FEED=iex
