# Copy this file to .env and fill in the keys for your market profile.

# Market profile: "eu" (European exchanges, EUR — default) or "us" (Alpaca).
BOT_MARKET=eu

# --- EU profile: Interactive Brokers (UCITS ETFs on Xetra) --------------------
# Requires a running TWS or IB Gateway, logged in to your IBKR account.
# Ports: 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper, 4001 = Gateway live.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
# Shorting UCITS ETFs requires a margin account; set to 1 to enable.
IBKR_ALLOW_SHORTS=0
# The bot screens for liquid US stocks itself (IBKR scanner) and trades them
# long/short with the mean-reversion strategy. 0 = disable.
US_STOCK_COUNT=3

# Separate budgets (base currency, 0 = unlimited): max total open position
# value per category. New entries are capped/skipped once the budget is used.
CRYPTO_BUDGET=0
STOCKS_BUDGET=0

# Crypto pairs for the breakout strategy (anything Kraken lists in EUR works,
# meme coins included): e.g. CRYPTO_SYMBOLS=BTC/EUR,ETH/EUR,DOGE/EUR
CRYPTO_SYMBOLS=BTC/EUR

# Strategy lab: every STRATEGY_LAB_HOURS the bot backtests its candidate
# crypto strategies on recent candles and switches only when a challenger
# beats the incumbent in both halves of the history by at least
# STRATEGY_LAB_MIN_IMPROVEMENT (0.25 = 25%). 0 hours = lab off.
STRATEGY_LAB_HOURS=24
STRATEGY_LAB_MIN_IMPROVEMENT=0.25

# --- EU profile: Kraken (BTC/EUR) -----------------------------------------------
# Leave empty for paper mode: real Kraken prices, simulated fills.
# For live trading: Kraken -> Settings -> API, permissions "Query Funds" and
# "Create & Modify Orders" only (NO withdrawals).
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Virtual EUR balance for the BTC paper mode.
KRAKEN_PAPER_CASH=10000

# --- Telegram notifications (optional, recommended) ---------------------------
# Create a bot via @BotFather; see trade_bot/notify.py for the steps.
# Sharing the same token/chat with the original crypto bot is fine: this
# bot's messages get their own prefix so you can tell them apart.
# You'll get a message for every trade, the daily P&L, US stock universe
# changes and (rate-limited) errors.
#TELEGRAM_BOT_TOKEN=123456:ABC...
#TELEGRAM_CHAT_ID=123456789
# Label prefixed to this bot's messages (empty = no prefix)
TELEGRAM_PREFIX=[Multi-bot]

# --- US profile: Alpaca ------------------------------------------------------------
# Paper trading keys: https://app.alpaca.markets (Paper account -> API Keys)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Paper trading by default. For live trading (real money, own risk):
# ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Market data feed: "iex" is free, "sip" requires a paid data subscription.
ALPACA_DATA_FEED=iex

# =============================================================================
# Shorts-bot (shorts_bot/) — YouTube Shorts, volledig lokaal gerenderd.
# Los van de trading-bot hierboven. Zie shorts_bot/README.md.
# =============================================================================

# Welke niches, afgewisseld op volgorde. Zie shorts_bot/niches.py.
SHORTS_NICHES=markets_finance,horror_mystery
SHORTS_LANGUAGE=en

# 2-3 per dag. De bot verschuift elke tijd met wat speling (deterministisch per
# dag, zodat een herstart dezelfde tijdslots berekent en niets dubbel post).
SHORTS_PER_DAY=3
SHORTS_POST_TIMES=09:10,14:20,19:30
SHORTS_JITTER_MINUTES=20
SHORTS_TIMEZONE=Europe/Amsterdam

# private | unlisted | public. Begin met private en keur zelf goed in Studio;
# zet dit later om zodra je de kwaliteit vertrouwt. Let op: bij een nog niet
# goedgekeurd ("unaudited") Google-project forceert YouTube sowieso private.
SHORTS_PRIVACY=private

# 1 = alles maken maar niets uploaden; de video komt in de state-map te staan.
SHORTS_DRY_RUN=0
# 1 = werkmappen per video bewaren, handig als er iets misgaat.
SHORTS_KEEP_WORK=0

# Exportstand: alles renderen maar niets uploaden, en de losse onderdelen
# wegschrijven in een map die je zo in CapCut sleept — clips, stem, captions.srt
# en de YouTube-teksten. Kan ook per keer met: shorts_bot.main once --export
SHORTS_EXPORT=0
SHORTS_EXPORT_DIR=shorts_export

# --- De schrijver ------------------------------------------------------------
# Dezelfde sleutel als elders; kost enkele centen per video.
ANTHROPIC_API_KEY=
SHORTS_CLAUDE_MODEL=claude-opus-5
# low | medium | high — hoger denkt langer na over het idee.
SHORTS_CLAUDE_EFFORT=medium
# Aantal shots per video; 6 x 5s = een Short van 30 seconden.
SHORTS_SHOTS=6

# --- De stem (Kokoro-82M, Apache 2.0, draait op de CPU) ----------------------
SHORTS_TTS_BACKEND=kokoro
# am_* = American male, af_* = American female, bm_* = British male.
SHORTS_TTS_VOICE=am_michael
SHORTS_TTS_LANG=a
SHORTS_TTS_SPEED=1.0
# Andere engine gebruiken? Zet backend op 'command' en vul hier je eigen
# opdracht in, met {text} en {out} erin.
#SHORTS_TTS_BACKEND=command
#SHORTS_TTS_COMMAND=piper -m stem.onnx -f {out} -- {text}

# --- Het beeld (LTX-2.3) -----------------------------------------------------
# 'dummy' maakt testclips met ffmpeg, zodat de keten zonder GPU draait.
SHORTS_VIDEO_BACKEND=ltx
LTX_REPO=/home/soewels/LTX-2
LTX_MODULE=ltx_pipelines.distilled
LTX_PYTHON=uv run python

# Paden binnen LTX_REPO. Controleer de bestandsnamen na het downloaden —
# met 10 GB VRAM wil je de Q4_K_S-variant.
LTX_TRANSFORMER=models/ltx-2.3/diffusion_models/ltx-2.3-distilled-transformer-q4_k_s.gguf
LTX_TEXT_ENCODER=models/ltx-2.3/text_encoders/text-encoder.safetensors
LTX_VIDEO_VAE=models/ltx-2.3/vae/video-vae.safetensors
LTX_AUDIO_VAE=models/ltx-2.3/vae/audio-vae.safetensors
LTX_SPATIAL_UPSAMPLER=

# 544x960 is wat er op een 3080 (10 GB) past; ffmpeg schaalt daarna op naar 1080x1920.
LTX_WIDTH=544
LTX_HEIGHT=960
LTX_NUM_FRAMES=121
LTX_FPS=24
LTX_QUANTIZATION=fp8-cast
LTX_OFFLOAD=cpu
LTX_TIMEOUT=1800

# Vlagnamen verschillen per LTX-versie; 'doctor' toont welke die van jou kent.
LTX_WIDTH_FLAG=--width
LTX_HEIGHT_FLAG=--height
LTX_EXTRA_ARGS=

# --- Woord-timing ------------------------------------------------------------
SHORTS_WHISPER_MODEL=base.en
SHORTS_WHISPER_DEVICE=cpu
SHORTS_WHISPER_COMPUTE=int8

# --- Montage -----------------------------------------------------------------
SHORTS_OUT_WIDTH=1080
SHORTS_OUT_HEIGHT=1920
SHORTS_CAPTION_FONT=Arial
# Sfeergeluid van LTX onder de stem mixen, en hoe ver eronder.
SHORTS_AMBIENCE=1
SHORTS_AMBIENCE_DB=-18

# --- YouTube -----------------------------------------------------------------
# OAuth-client van het type "Desktop app" uit Google Cloud Console.
YOUTUBE_CLIENT_SECRETS=client_secret.json
# Een upload kost 1600 van de 10.000 eenheden per dag: maximaal zes per dag.
YOUTUBE_QUOTA_LIMIT=10000
YOUTUBE_UPLOAD_COST=1600
YOUTUBE_MADE_FOR_KIDS=0
