# Copy this file to .env and fill in the keys for your market profile.

# Market profile: "eu" (European exchanges, EUR — default) or "us" (Alpaca).
BOT_MARKET=eu

# --- EU profile: Interactive Brokers (UCITS ETFs on Xetra) --------------------
# Requires a running TWS or IB Gateway, logged in to your IBKR account.
# Ports: 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper, 4001 = Gateway live.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
# Shorting UCITS ETFs requires a margin account; set to 1 to enable.
IBKR_ALLOW_SHORTS=0
# The bot screens for liquid US stocks itself (IBKR scanner) and trades them
# long/short with the mean-reversion strategy. 0 = disable.
US_STOCK_COUNT=3

# --- EU profile: Kraken (BTC/EUR) -----------------------------------------------
# Leave empty for paper mode: real Kraken prices, simulated fills.
# For live trading: Kraken -> Settings -> API, permissions "Query Funds" and
# "Create & Modify Orders" only (NO withdrawals).
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Virtual EUR balance for the BTC paper mode.
KRAKEN_PAPER_CASH=10000

# --- Telegram notifications (optional, recommended) ---------------------------
# Create a bot via @BotFather; see trade_bot/notify.py for the steps.
# Sharing the same token/chat with the original crypto bot is fine: this
# bot's messages get their own prefix so you can tell them apart.
# You'll get a message for every trade, the daily P&L, US stock universe
# changes and (rate-limited) errors.
#TELEGRAM_BOT_TOKEN=123456:ABC...
#TELEGRAM_CHAT_ID=123456789
# Label prefixed to this bot's messages (empty = no prefix)
TELEGRAM_PREFIX=[Multi-bot]

# --- US profile: Alpaca ------------------------------------------------------------
# Paper trading keys: https://app.alpaca.markets (Paper account -> API Keys)
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Paper trading by default. For live trading (real money, own risk):
# ALPACA_BASE_URL=https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Market data feed: "iex" is free, "sip" requires a paid data subscription.
ALPACA_DATA_FEED=iex
