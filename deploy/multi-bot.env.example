# Configuratie voor de multi-bot service (bot/, EU-profiel).
# Kopieer dit bestand naar /etc/multi-bot.env en vul je eigen waarden in.
# Zet daarna de rechten strak:  sudo chmod 600 /etc/multi-bot.env
#
# Dit bestand wordt door TWEE dingen gelezen:
#   - de multi-bot systemd-service (bot-instellingen)
#   - de IB Gateway docker-container (TWS_* inloggegevens)

# --- marktprofiel ---
BOT_MARKET=eu

# --- IB Gateway (docker-container, zie deploy/ib-gateway/) ---
# Je IBKR-inloggegevens. Begin ALTIJD met je paper-account!
TWS_USERID=vul_hier_je_ibkr_gebruikersnaam_in
TWS_PASSWORD=vul_hier_je_ibkr_wachtwoord_in
# paper = oefengeld, live = echt geld (eigen risico)
TRADING_MODE=paper
TZ=Europe/Amsterdam

# --- verbinding van de bot naar de gateway ---
IBKR_HOST=127.0.0.1
# 4002 = paper via de gateway-container, 4001 = live
IBKR_PORT=4002
IBKR_CLIENT_ID=17
# Shorts op UCITS-ETF's vereisen een margin-account; 1 = aan
IBKR_ALLOW_SHORTS=0

# --- zelfzoekende aandelen (0 = uit) ---
US_STOCK_COUNT=3
# Regio's waarin de scanner zoekt: US, EU en/of ASIA (komma-gescheiden).
# Londen is bewust uitgesloten (pence-notering).
STOCK_REGIONS=US,EU,ASIA

# --- crypto-munten (breakout-strategie via Kraken) ---
# Zelfzoekend (standaard): de bot scant elke 12 uur ALLE Kraken-EUR-munten,
# filtert op liquiditeit (>= 2 mln EUR omzet/dag, geen stablecoins) en houdt
# de sterkste stijgers aan. Munten met open positie blijven altijd staan.
CRYPTO_AUTO_COUNT=5
#CRYPTO_MIN_EUR_VOLUME=2000000
#CRYPTO_RESCAN_HOURS=12
# Candle-grootte in minuten voor handel én scanner (5/15/30/60/240).
# 60 = rustig (uitbraken per uur), 15 = alert op snelle bewegingen zoals
# meme-coin-pumps, maar met meer valse signalen en meer trades.
#CRYPTO_TIMEFRAME_MINUTES=60
# Liever zelf kiezen? Zet CRYPTO_AUTO_COUNT=0 en geef een vaste lijst op:
#   CRYPTO_SYMBOLS=BTC/EUR,ETH/EUR,DOGE/EUR,PEPE/EUR
# (in auto-modus is deze lijst het startpunt tot de eerste scan klaar is)
CRYPTO_SYMBOLS=BTC/EUR

# --- aparte potjes (0 = geen limiet) ---
# Maximaal totaalbedrag (EUR) aan open posities per categorie. De bot opent
# geen nieuwe positie meer (of maakt hem kleiner) zodra het potje vol zit.
CRYPTO_BUDGET=0
STOCKS_BUDGET=0
# Maximum per lósse positie (EUR, 0 = uit). Garandeert spreiding: zonder dit
# kan een rustig instrument in z'n eentje het hele potje vullen.
CRYPTO_MAX_PER_POSITION=0
STOCKS_MAX_PER_POSITION=0

# --- Telegram-meldingen (optioneel, aanrader) ---
# Zelfde token/chat-id als je oude trade-bot mag gewoon: alle meldingen van
# deze bot krijgen een eigen label ervoor zodat je ze uit elkaar houdt.
# Je krijgt een berichtje bij elke koop/verkoop/stop, het dagresultaat,
# wijzigingen in de US-aandelenselectie en (max 1x/kwartier) bij storingen.
#TELEGRAM_BOT_TOKEN=123456:ABC...
#TELEGRAM_CHAT_ID=123456789
# Label voor de meldingen van deze bot (leeg = geen label)
TELEGRAM_PREFIX=[Multi-bot]

# --- Mobiel dashboard ---
# Draait op poort 8081 (oude bot: 8080), standaard alleen op localhost.
# Meekijken vanaf je telefoon: installeer Tailscale op server + telefoon en
# zet WEB_HOST=0.0.0.0 met een firewall, of gebruik een SSH-tunnel:
#   ssh -L 8081:localhost:8081 root@<server-ip>  ->  http://localhost:8081
# Vaste toegangscode voor de pauze/noodstop-knoppen (leeg = random, zie logs):
WEB_CODE=kies_hier_zelf_een_code

# --- Kraken (BTC/EUR) ---
# Leeg laten = paper-modus: echte koersen, gesimuleerde fills.
# Live: alleen 'Query Funds' en 'Create & Modify Orders' rechten, GEEN withdrawals.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_PAPER_CASH=10000
