# Configuratie voor de trade-bot service.
# Kopieer dit bestand naar /etc/trade-bot.env en vul je eigen waarden in.
# Zet daarna de rechten strak:  sudo chmod 600 /etc/trade-bot.env

# --- Binance API-keys ---
# Testnet-keys: gratis via https://testnet.binance.vision
# Live-keys: alleen spot-handel aanzetten, opnames (withdrawals) UIT
BINANCE_API_KEY=vul_hier_je_key_in
BINANCE_API_SECRET=vul_hier_je_secret_in

# --- Telegram-meldingen (optioneel, aanrader) ---
# Maak een bot via @BotFather; zie trade_bot/notify.py voor de stappen
#TELEGRAM_BOT_TOKEN=123456:ABC...
#TELEGRAM_CHAT_ID=123456789

# --- Argumenten voor de bot ---
# Begin ALTIJD met --testnet. Pas naar --live als het weken goed draait.
BOT_ARGS=--symbol BTCUSDT --interval 15m --strategy auto --testnet --web --state /opt/trade-bot/bot_state.json

# Alleen voor --live onder systemd: omdat er geen terminal is om de
# bevestiging in te typen, moet je hier expliciet het handelspaar herhalen.
# Pas aanzetten als je er klaar voor bent:
#LIVE_TRADING_ACK=BTCUSDT
